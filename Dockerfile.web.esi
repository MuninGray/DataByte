FROM php:8.3-apache
RUN a2enmod proxy proxy_http rewrite headers
COPY docker/apache/web-site-esi.conf /etc/apache2/sites-available/000-default.conf
COPY ["Landing page/", "/var/www/html/Landing page/"]
COPY ["assets/", "/var/www/html/assets/"]
COPY ["mapa.html", "/var/www/html/mapa.html"]
EXPOSE 80
